op: 195px;">  EndColor #E74C3C</div><div class="ace_line" style="height: 15px; top: 210px;">  FontSize <span class="ace_constant ace_numeric">13</span></div><div class="ace_line" style="height: 15px; top: 225px;"><span class="ace_bracket">}</span></div><div class="ace_line" style="height: 15px; top: 240px;"><span class="ace_keyword">skinparam</span> ArrowColor #<span class="ace_constant ace_numeric">64748</span>B</div><div class="ace_line" style="height: 15px; top: 255px;"></div><div class="ace_line" style="height: 15px; top: 270px;">|Patient|</div><div class="ace_line" style="height: 15px; top: 285px;"><span class="ace_keyword">start</span></div><div class="ace_line" style="height: 15px; top: 300px;">:Open Damumed;</div><div class="ace_line" style="height: 15px; top: 315px;">:Log in;</div><div class="ace_line" style="height: 15px; top: 330px;"></div><div class="ace_line" style="height: 15px; top: 345px;">|System|</div><div class="ace_line" style="height: 15px; top: 360px;">:Verify credentials;</div><div class="ace_line" style="height: 15px; top: 375px;"></div><div class="ace_line" style="height: 15px; top: 390px;"><span class="ace_keyword">if</span> (Valid credentials?) <span class="ace_keyword">then</span> (Yes)</div><div class="ace_line" style="height: 15px; top: 405px;">  |Patient|</div><div class="ace_line" style="height: 15px; top: 420px;">  :Select a doctor;</div><div class="ace_line" style="height: 15px; top: 435px;">  :Choose appointment date;</div><div class="ace_line" style="height: 15px; top: 450px;"></div><div class="ace_line" style="height: 15px; top: 465px;">  |System|</div></div><div class="ace_layer ace_marker-layer"></div><div class="ace_layer ace_cursor-layer ace_hidden-cursors"><div class="ace_cursor" style="display: block; top: 825px; left: 55px; width: 7px; height: 15px; animation-duration: 1000ms;"></div></div></div></div><div class="ace_scrollbar ace_scrollbar-v" style="width: 20px; bottom: 0px;"><div class="ace_scrollbar-inner" style="width: