@startuml
title DAMUMED - Appointment Booking Process

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam activity {
  BackgroundColor #EAF2F8
  BorderColor #3498DB
  FontColor #1B2631
  DiamondBackgroundColor #FFF2CC
  DiamondBorderColor #D4AC0D
  StartColor #27AE60
  EndColor #E74C3C
  FontSize 13
}
skinparam ArrowColor #64748B

|Patient|
start
:Open Damumed;
:Log in;

|System|
:Verify credentials;

if (Valid credentials?) then (Yes)
  |Patient|
  :Select a doctor;
  :Choose appointment date;

  |System|
  :Check doctor's schedule;

  if (Available time?) then (Yes)
    |Patient|
    :Select time slot;
    :Confirm appointment;

    |System|
    :Save appointment;
    :Send confirmation;

    |Patient|
    :View appointment details;
  else (No)
    |System|
    :Display "No available slots";
  endif

else (No)
  :Display login error;
endif

stop
@enduml
